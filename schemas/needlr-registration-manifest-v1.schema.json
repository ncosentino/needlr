{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://needlr.dev/schemas/needlr-registration-manifest-v1.schema.json",
  "title": "Needlr Source-Generated Registration Manifest",
  "description": "Analyzer-readable metadata describing the normalized registration plan emitted by Needlr source generation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assemblyName",
    "isAotProject",
    "serviceCatalogRegistration",
    "referencedRegistryAssemblies",
    "injectableTypes",
    "decorators",
    "hostedServices",
    "interceptedServices",
    "factories",
    "providers",
    "options",
    "httpClients",
    "composedRegistrations",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "assemblyName": {
      "type": "string"
    },
    "isAotProject": {
      "type": "boolean"
    },
    "serviceCatalogRegistration": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/definitions/serviceCatalogRegistration"
        }
      ]
    },
    "referencedRegistryAssemblies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "injectableTypes": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/injectableType"
      }
    },
    "decorators": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/decorator"
      }
    },
    "hostedServices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/hostedService"
      }
    },
    "interceptedServices": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/interceptedService"
      }
    },
    "factories": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/factory"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/provider"
      }
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/options"
      }
    },
    "httpClients": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/httpClient"
      }
    },
    "composedRegistrations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/composedRegistration"
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/plugin"
      }
    }
  },
  "definitions": {
    "lifetime": {
      "type": "string",
      "enum": [
        "Singleton",
        "Scoped",
        "Transient"
      ]
    },
    "nullableTypeName": {
      "type": [
        "string",
        "null"
      ]
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constructorParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "serviceKey"
      ],
      "properties": {
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "type": {
          "type": "string"
        },
        "serviceKey": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "constructorParameters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/constructorParameter"
      }
    },
    "serviceCatalogRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceType",
        "implementationType",
        "lifetime"
      ],
      "properties": {
        "serviceType": {
          "type": "string"
        },
        "implementationType": {
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/definitions/lifetime"
        }
      }
    },
    "injectableType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationType",
        "assemblyName",
        "lifetime",
        "serviceTypes",
        "serviceKeys",
        "constructorParameters"
      ],
      "properties": {
        "implementationType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/definitions/lifetime"
        },
        "serviceTypes": {
          "$ref": "#/definitions/stringArray"
        },
        "serviceKeys": {
          "$ref": "#/definitions/stringArray"
        },
        "constructorParameters": {
          "$ref": "#/definitions/constructorParameters"
        }
      }
    },
    "decorator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceType",
        "decoratorType",
        "order",
        "assemblyName"
      ],
      "properties": {
        "serviceType": {
          "type": "string"
        },
        "decoratorType": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "assemblyName": {
          "type": "string"
        }
      }
    },
    "hostedService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationType",
        "assemblyName",
        "lifetime",
        "constructorParameters"
      ],
      "properties": {
        "implementationType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/definitions/lifetime"
        },
        "constructorParameters": {
          "$ref": "#/definitions/constructorParameters"
        }
      }
    },
    "interceptedService": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementationType",
        "proxyType",
        "assemblyName",
        "lifetime",
        "serviceTypes",
        "interceptorTypes"
      ],
      "properties": {
        "implementationType": {
          "type": "string"
        },
        "proxyType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/definitions/lifetime"
        },
        "serviceTypes": {
          "$ref": "#/definitions/stringArray"
        },
        "interceptorTypes": {
          "$ref": "#/definitions/stringArray"
        }
      }
    },
    "factoryConstructor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "injectableParameters",
        "runtimeParameters"
      ],
      "properties": {
        "injectableParameters": {
          "$ref": "#/definitions/constructorParameters"
        },
        "runtimeParameters": {
          "$ref": "#/definitions/constructorParameters"
        }
      }
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetType",
        "returnType",
        "assemblyName",
        "generatesFunc",
        "generatesInterface",
        "generatedFactoryServiceType",
        "generatedFactoryImplementationType",
        "constructors"
      ],
      "properties": {
        "targetType": {
          "type": "string"
        },
        "returnType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "generatesFunc": {
          "type": "boolean"
        },
        "generatesInterface": {
          "type": "boolean"
        },
        "generatedFactoryServiceType": {
          "$ref": "#/definitions/nullableTypeName"
        },
        "generatedFactoryImplementationType": {
          "$ref": "#/definitions/nullableTypeName"
        },
        "constructors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/factoryConstructor"
          }
        }
      }
    },
    "providerProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "serviceType",
        "resolutionKind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "serviceType": {
          "type": "string"
        },
        "resolutionKind": {
          "type": "string",
          "enum": [
            "Required",
            "Optional",
            "Collection",
            "Factory"
          ]
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceType",
        "assemblyName",
        "mode",
        "serviceType",
        "implementationType",
        "properties"
      ],
      "properties": {
        "sourceType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "interface",
            "shorthand"
          ]
        },
        "serviceType": {
          "type": "string"
        },
        "implementationType": {
          "type": "string"
        },
        "properties": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/providerProperty"
          }
        }
      }
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionsType",
        "assemblyName",
        "sectionName",
        "name",
        "bindingMode",
        "validateOnStart",
        "generatedValidatorType",
        "generatedDataAnnotationsValidatorType",
        "externalValidatorType"
      ],
      "properties": {
        "optionsType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "sectionName": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "bindingMode": {
          "type": "string",
          "enum": [
            "reflection",
            "aot-configure",
            "aot-init-only",
            "aot-positional-record"
          ]
        },
        "validateOnStart": {
          "type": "boolean"
        },
        "generatedValidatorType": {
          "$ref": "#/definitions/nullableTypeName"
        },
        "generatedDataAnnotationsValidatorType": {
          "$ref": "#/definitions/nullableTypeName"
        },
        "externalValidatorType": {
          "$ref": "#/definitions/nullableTypeName"
        }
      }
    },
    "httpClient": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "optionsType",
        "assemblyName",
        "clientName",
        "sectionName",
        "capabilities"
      ],
      "properties": {
        "optionsType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "sectionName": {
          "type": "string"
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "Timeout",
              "UserAgent",
              "BaseAddress",
              "Headers"
            ]
          }
        }
      }
    },
    "composedRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "serviceType",
        "implementationType",
        "assemblyName",
        "lifetime",
        "constructorArguments"
      ],
      "properties": {
        "serviceType": {
          "type": "string"
        },
        "implementationType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "lifetime": {
          "$ref": "#/definitions/lifetime"
        },
        "constructorArguments": {
          "$ref": "#/definitions/stringArray"
        }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginType",
        "assemblyName",
        "order",
        "pluginInterfaces",
        "attributeTypes"
      ],
      "properties": {
        "pluginType": {
          "type": "string"
        },
        "assemblyName": {
          "type": "string"
        },
        "order": {
          "type": "integer"
        },
        "pluginInterfaces": {
          "$ref": "#/definitions/stringArray"
        },
        "attributeTypes": {
          "$ref": "#/definitions/stringArray"
        }
      }
    }
  }
}
